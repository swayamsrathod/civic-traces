# Copy this file to .env and fill in your own values.
# Never commit the real .env file.

# LLM provider
ANTHROPIC_API_KEY=your_key_here

# SQLite database file
DB_PATH=civictrace.db

# Email used to file complaints
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_app_password

# Days before an unanswered complaint is escalated
ESCALATION_DAYS=3

# Emails are only printed, not sent, while this is true
DRY_RUN=true

# Model used for photo classification
CLAUDE_MODEL=claude-sonnet-5-5

# Demo portal address
PORTAL_URL=http://localhost:8080/index.html

# Demo mode: follow up after this many minutes instead of ESCALATION_DAYS
# ESCALATION_MINUTES=1

# How often the background job checks for due follow-ups (0 turns it off)
FOLLOWUP_CHECK_SECONDS=30
